* text=auto

*.m text eol=lf
*.md text eol=lf
*.cff text eol=lf
*.csv text eol=lf
*.txt text eol=lf

*.png binary
*.pdf binary
*.mat binary

# Preserve third-party provenance byte-for-byte, including original
# whitespace and line endings.
src/vendor/** -text -whitespace
src/benchmarks/provenance/** -text -whitespace
